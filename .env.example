APP_NAME="Store Pailot AI Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://storepailotadmin.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=store-pailot-db
DB_PORT=3306
DB_DATABASE=store_pailot_ai_admin
DB_USERNAME=store
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

COMMERCEPILOT_AI_PROVIDER=openai
COMMERCEPILOT_AI_MODEL=gpt-4.1-mini
COMMERCEPILOT_AI_TIMEOUT=30
COMMERCEPILOT_MAX_TOOL_ITERATIONS=5
COMMERCEPILOT_MAX_CONTEXT_MESSAGES=20
COMMERCEPILOT_WORDPRESS_TIMEOUT=10
COMMERCEPILOT_WORDPRESS_RETRY_TIMES=2
COMMERCEPILOT_VISITOR_RATE_LIMIT=20
COMMERCEPILOT_SITE_RATE_LIMIT=100
COMMERCEPILOT_SITE_DAILY_RATE_LIMIT=500
COMMERCEPILOT_HMAC_TIMESTAMP_TOLERANCE=300
COMMERCEPILOT_CONVERSATION_RETENTION_DAYS=90
COMMERCEPILOT_API_LOG_RETENTION_DAYS=30
COMMERCEPILOT_UPGRADE_URL=https://app.commercepilot.com/upgrade
COMMERCEPILOT_DEFAULT_CURRENCY=USD
COMMERCEPILOT_SITE_TOKEN_PREFIX=cp_live_
COMMERCEPILOT_SITE_TOKEN_LENGTH=48
